        className="card-main"
        onClick={() => onSelect(pokemon)}
        aria-label={`Ver detalhes de ${pokemon.name}, número ${formattedId}`}
      >
        <span className="pokemon-id">Nº {formattedId}</span>

        <span className="pokemon-image-container">
