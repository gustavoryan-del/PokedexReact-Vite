/* ==========================================================================
   Animações
   ========================================================================== */
@keyframes lens-boot {
  0% {
    box-shadow:
      0 0 0 4px var(--bezel),
      0 6px 12px rgba(0, 0, 0, 0.4),
      0 0 0 0 rgba(77, 215, 245, 0),
      inset 0 -6px 12px rgba(0, 30, 80, 0.5);
    filter: brightness(0.5);
  }
  40% {
    box-shadow:
      0 0 0 4px var(--bezel),
      0 6px 12px rgba(0, 0, 0, 0.4),
      0 0 30px 10px rgba(77, 215, 245, 0.85),
      inset 0 -6px 12px rgba(0, 30, 80, 0.5);
    filter: brightness(1.4);
  }
  100% {
    box-shadow:
      0 0 0 4px var(--bezel),
      0 6px 12px rgba(0, 0, 0, 0.4),
      0 0 0 0 rgba(77, 215, 245, 0),
      inset 0 -6px 12px rgba(0, 30, 80, 0.5);
    filter: none;
  }
}

@keyframes led-on {
  from {
    filter: brightness(0.35) saturate(0.6);
  }
  to {
    filter: none;
  }
}

@keyframes screen-on {
  0% {
    opacity: 0;
    transform: scaleY(0.04);
    filter: brightness(3);
  }
  45% {
    opacity: 1;
    transform: scaleY(1.02);
    filter: brightness(1.8);
  }
  100% {
    opacity: 1;
    transform: none;
    filter: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-delay: 0s !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}

/* ==========================================================================
   Responsivo
   ========================================================================== */
@media (max-width: 640px) {
  .pokedex {
    width: 100%;
    margin: 0;
    border-width: 0 0 4px;
    border-radius: 0 0 24px 24px;
  }

  .dex-top {
    flex-wrap: wrap;
    gap: 12px;
    padding: max(14px, env(safe-area-inset-top)) 16px 14px;
  }

  .dex-lens {
    width: 52px;
    height: 52px;
    border-width: 4px;
  }

  .app-logo {
    height: 34px;
  }

  .dex-main {
    padding: 14px 12px 4px;
  }

  .dex-screen {
    padding: 12px;
    border-width: 6px;
    border-radius: 12px 12px 12px 32px;
  }

  .dex-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    padding: 14px 16px max(20px, env(safe-area-inset-bottom));
  }

  .dex-grille {
    display: none;
  }
}

/* ==========================================================================
   Responsividade avançada
   ========================================================================== */

/* Tablet */
@media (min-width: 641px) and (max-width: 1024px) {
  .pokedex {
    width: min(100% - 24px, 900px);
    margin: 16px auto;
  }

  .dex-main {
    padding: 18px 18px 4px;
  }

  .dex-screen {
    padding: 16px;
  }
}

/* Desktop largo */
@media (min-width: 1280px) {
  .pokedex {
    width: min(100% - 48px, 1240px);
  }
}

/* Telas de toque: alvos maiores (mínimo recomendado de 44px) */
@media (pointer: coarse) {
  .dex-button {
    min-height: 44px;
  }

  .type-chip {
    padding: 9px 14px;
  }

  .search-input {
    padding-block: 14px;
  }

  .close-button {
    width: 44px;
    height: 44px;
    margin-top: -22px;
  }
}
</file>

<file path="src/css/PokemonCard.css">
.pokemon-card {
  position: relative;
  display: flex;
  background: var(--screen-card);
  border: 2px solid var(--screen-line);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.pokemon-card:hover,
.pokemon-card:focus-within {
  transform: translateY(-3px);
  border-color: var(--card-type);
  box-shadow: 0 10px 24px color-mix(in srgb, var(--card-type) 30%, transparent);
}

.card-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  text-align: left;
}

.card-main:focus-visible {
  outline-offset: -4px;
}

.pokemon-id {
  padding-top: 4px;
  font-family: var(--font-pixel);
  font-size: 0.6rem;
  line-height: 1;
  color: var(--screen-glow);
}

.pokemon-image-container {
  position: relative;
  display: grid;
  place-items: center;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: var(--radius-sm);
  border: 1px solid var(--screen-line);
  background:
    radial-gradient(circle at 50% 62%, color-mix(in srgb, var(--card-type) 38%, transparent) 0, transparent 68%),
    var(--screen-well);
}

.card-watermark {
  --pb-top: var(--card-type);
  --pb-bottom: var(--text-primary);
  --pb-line: var(--text-primary);
  position: absolute;
  top: -10%;
  left: -10%;
  width: 120%;
  height: 120%;
  opacity: 0.1;
  transform: rotate(-18deg);
}

.pokemon-image {
  position: relative;
  width: 84%;
  height: 84%;
  object-fit: contain;
  filter: drop-shadow(0 6px 6px rgba(0, 0, 0, 0.5));
  transition: transform 0.25s ease;
}

.pokemon-card:hover .pokemon-image,
.pokemon-card:focus-within .pokemon-image {
  transform: scale(1.07);
}

.pokemon-name {
  font-size: 1.05rem;
  font-weight: 700;
  line-height: 1.2;
  text-transform: capitalize;
}

/* Os seis atributos base, em grade 3x2 */
.card-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 6px;
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px dashed var(--screen-line);
}

.card-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  padding: 5px 2px;
  background: var(--screen-well);
  border-radius: 6px;
}

.card-stat-label {
  font-size: 0.68rem;
  color: var(--text-secondary);
}

.card-stat-value {
  font-family: var(--font-pixel);
  font-size: 0.62rem;
  color: var(--text-primary);
}

/* Botão de capturar */
.capture-button {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 2;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--bezel);
  border: 2px solid var(--screen-line);
  transition: transform 0.12s ease, border-color 0.15s ease;
}

.capture-button:hover {
  border-color: var(--screen-glow);
}

.capture-button:active {
  transform: scale(0.88);
}

.capture-button .pokeball {
  --pb-top: #5b6b7a;
  --pb-bottom: #aab8c4;
  --pb-button: #aab8c4;
  --pb-line: #0d1822;
  transition: transform 0.45s ease;
}

.is-captured .capture-button {
  border-color: var(--led-yellow);
}

.is-captured .capture-button .pokeball {
  --pb-top: var(--dex-red);
  --pb-bottom: #ffffff;
  --pb-button: #ffffff;
  --pb-line: var(--bezel);
  transform: rotate(360deg);
}

/* Atributo usado na ordenação fica em destaque */
.card-stat.is-highlighted {
  outline: 1px solid var(--screen-glow);
}

.card-stat.is-highlighted .card-stat-value {
  color: var(--screen-glow);
}

/* Botão de comparar (ao lado do botão de capturar) */
.compare-button {
  position: absolute;
  top: 8px;
  right: 42px;
  z-index: 2;
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--bezel);
  border: 2px solid var(--screen-line);
  color: #aab8c4;
  transition: transform 0.12s ease, border-color 0.15s ease, color 0.15s ease;
}

.compare-button svg {
  width: 16px;
  height: 16px;
}

.compare-button:hover {
  border-color: var(--glow-on-dark);
  color: #ffffff;
}

.compare-button:active {
  transform: scale(0.88);
}

.compare-button[aria-pressed='true'] {
  border-color: var(--glow-on-dark);
  color: var(--glow-on-dark);
  background: #0f3040;
  box-shadow: 0 0 8px rgba(77, 215, 245, 0.5);
}
</file>

<file path="src/css/PokemonDetails.css">
.entry-body {
  display: grid;
  grid-template-columns: 1fr 1.25fr;
  gap: 16px;
  padding: 18px;
}

@media (max-width: 640px) {
  .entry-body {
    grid-template-columns: 1fr;
  }
}

/* ----- Tela da imagem ----- */
.entry-visual {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 16px;
}

.entry-image-wrap {
  position: relative;
  width: 100%;
  max-width: 260px;
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  background: radial-gradient(circle, color-mix(in srgb, var(--entry-type) 45%, transparent) 0, transparent 68%);
}

.entry-watermark {
  --pb-top: var(--entry-type);
  --pb-bottom: var(--text-primary);
  --pb-line: var(--text-primary);
  position: absolute;
  inset: 4%;
  width: 92%;
  height: 92%;
  opacity: 0.1;
}

.entry-image {
  position: relative;
  width: 88%;
  height: 88%;
  object-fit: contain;
  filter: drop-shadow(0 8px 8px rgba(0, 0, 0, 0.5));
  animation: entry-swap 0.3s ease-out;
}

.entry-visual .pokemon-types {
  justify-content: center;
}

/* ----- Tela das estatísticas ----- */
.entry-stats {
  padding: 18px 18px 14px;
}

.entry-stats h3 {
  margin-bottom: 14px;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--screen-glow);
}

.stat-list {
  list-style: none;
  display: grid;
  gap: 10px;
}

.stat-row {
  display: grid;
  grid-template-columns: 92px 34px 1fr;
  align-items: center;
  gap: 10px;
}

.stat-name {
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.stat-value {
  font-family: var(--font-pixel);
  font-size: 0.7rem;
  text-align: right;
}

/* Barra segmentada, como um medidor de LCD */
.stat-bar-bg {
  position: relative;
  height: 10px;
  overflow: hidden;
  background: var(--screen-inset);
  border: 1px solid var(--screen-line);
  border-radius: 3px;
}

.stat-bar-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(90deg, transparent 0 7px, rgba(0, 0, 0, 0.5) 7px 8px);
}

.stat-bar-fill {
  height: 100%;
  width: var(--value);
  background: var(--entry-type);
  animation: bar-grow 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  animation-delay: calc(var(--position) * 60ms);
}

.stat-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px dashed var(--screen-line);
  font-size: 0.85rem;
  color: var(--text-secondary);
}

.stat-total strong {
  font-family: var(--font-pixel);
  font-size: 0.75rem;
  font-weight: 400;
  color: var(--accent-strong);
}

/* ----- Rodapé: anterior, capturar, próximo ----- */
.entry-footer {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12px;
  padding: 4px 18px 20px;
}

.nav-button {
  max-width: 100%;
}

.nav-button--prev {
  justify-self: start;
}

.nav-button--next {
  justify-self: end;
}

.nav-name {
  max-width: 11ch;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-transform: capitalize;
}

.capture-toggle .pokeball {
  --pb-top: #6b7a89;
  --pb-bottom: #c5d0da;
  --pb-button: #c5d0da;
  --pb-line: var(--bezel);
}

.capture-toggle[aria-pressed='true'] {
  background: linear-gradient(180deg, #ffe066, var(--led-yellow));
  color: #2a2200;
  box-shadow:
    0 4px 0 #a37f00,
    0 6px 10px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255, 255, 255, 0.5);
}

.capture-toggle[aria-pressed='true']:active {
  box-shadow: 0 1px 0 #a37f00, inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

.capture-toggle[aria-pressed='true'] .pokeball {
  --pb-top: var(--dex-red);
  --pb-bottom: #ffffff;
  --pb-button: #ffffff;
}

@media (max-width: 520px) {
  .entry-footer {
    grid-template-columns: 1fr 1fr;
  }

  .capture-toggle {
    grid-column: 1 / -1;
    order: -1;
  }

  .nav-button {
    width: 100%;
    justify-self: stretch;
  }
}

/* Animação dispara quando o usuário troca de Pokémon */
@keyframes entry-swap {
  from {
    opacity: 0;
    transform: translateX(14px) scale(0.96);
  }
}

@keyframes bar-grow {
  from {
    width: 0;
  }
}

/* ----- Dados complementares (PokéAPI) ----- */
.entry-extra {
  grid-column: 1 / -1;
  padding: 16px 18px;
}

.entry-extra h3 {
  margin-bottom: 10px;
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--screen-glow);
}

.extra-status {
  font-size: 0.9rem;
  color: var(--text-secondary);
}

.extra-genus {
  margin-bottom: 6px;
  font-weight: 700;
}

.extra-description {
  max-width: 70ch;
  margin-bottom: 14px;
  font-size: 0.92rem;
  line-height: 1.5;
}

.extra-facts {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
  gap: 12px;
}

.extra-facts > div {
  padding: 8px 10px;
  background: var(--screen-well);
  border: 1px solid var(--screen-line);
  border-radius: var(--radius-sm);
}

.extra-facts dt {
  margin-bottom: 3px;
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.extra-facts dd {
  font-size: 0.92rem;
  font-weight: 600;
}

.extra-abilities {
  grid-column: span 2;
}

.ability-list {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 4px 14px;
}

.ability-hidden {
  font-size: 0.72rem;
  font-weight: 400;
  color: var(--text-secondary);
}

@media (max-width: 520px) {
  .extra-abilities {
    grid-column: auto;
  }
}
</file>

<file path="src/css/PokemonList.css">
.pokemon-list-scroll {
  padding: 6px 4px 4px;
  scrollbar-width: thin;
  scrollbar-color: var(--screen-glow) var(--screen-inset);
}

/* Em telas maiores a lista rola dentro da "tela" da Pokédex */
@media (min-width: 720px) {
  .pokemon-list-scroll {
    max-height: min(64vh, 720px);
    overflow-y: auto;
  }
}

.pokemon-list-scroll::-webkit-scrollbar {
  width: 10px;
}

.pokemon-list-scroll::-webkit-scrollbar-track {
  background: var(--screen-inset);
  border-radius: 5px;
}

.pokemon-list-scroll::-webkit-scrollbar-thumb {
  background: var(--screen-glow);
  border-radius: 5px;
  border: 2px solid var(--screen-inset);
}

.pokemon-grid {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(176px, 1fr));
  gap: 14px;
}

.pokemon-grid > li {
  display: flex;
}

.pokemon-grid > li > .pokemon-card {
  flex: 1;
}

@media (max-width: 480px) {
  .pokemon-grid {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
}

.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 48px 16px;
  text-align: center;
}

.empty-pokeball {
  --pb-top: var(--muted-a);
  --pb-bottom: var(--muted-b);
  --pb-button: var(--muted-b);
  --pb-line: var(--screen-ink);
  margin-bottom: 6px;
}

.empty-title {
  font-size: 1.15rem;
  font-weight: 700;
}

.empty-hint {
  max-width: 38ch;
  margin-bottom: 8px;
  color: var(--text-secondary);
}

/* Tablet: cards um pouco mais compactos */
@media (min-width: 641px) and (max-width: 1024px) {
  .pokemon-grid {
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
  }
}

/* Desktop largo: mais colunas */
@media (min-width: 1280px) {
  .pokemon-grid {
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  }
}
</file>

<file path="src/css/SearchBar.css">
.search-and-filter-container {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 16px;
}

.search-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px 16px;
}

.search-bar-container {
  flex: 1 1 280px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 10px;
  background: var(--screen-inset);
  border: 2px solid var(--screen-line);
  border-radius: 10px;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.search-bar-container:focus-within {
  border-color: var(--screen-glow);
  box-shadow: 0 0 0 3px rgba(77, 215, 245, 0.2);
}

.search-icon {
  flex: none;
  color: var(--screen-glow);
}

.search-input {
  flex: 1;
  min-width: 0;
  padding: 12px 4px;
  background: transparent;
  border: none;
  outline: none;
  color: var(--text-primary);
  font-family: inherit;
  font-size: 1rem;
  font-weight: 500;
}

.search-input::placeholder {
  color: var(--text-secondary);
}

.search-clear {
  flex: none;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--text-secondary);
  font-size: 1.2rem;
  line-height: 1;
  transition: background 0.15s ease, color 0.15s ease;
}

.search-clear:hover {
  background: var(--screen-line);
  color: var(--text-primary);
}

.results-count {
  font-size: 0.9rem;
  color: var(--text-secondary);
  white-space: nowrap;
}

.results-count strong {
  font-family: var(--font-pixel);
  font-size: 0.7rem;
  font-weight: 400;
  color: var(--screen-glow);
}

.type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.type-chip {
  padding: 5px 12px;
  border: 2px solid var(--chip-color);
  border-radius: 999px;
  background: transparent;
  color: var(--text-primary);
  font-size: 0.82rem;
  font-weight: 600;
  transition: background 0.15s ease, color 0.15s ease, transform 0.1s ease;
}

.type-chip:hover:not(:disabled) {
  background: color-mix(in srgb, var(--chip-color) 25%, transparent);
}

.type-chip:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.type-chip:active:not(:disabled) {
  transform: scale(0.95);
}

.type-chip[aria-pressed='true'] {
  background: var(--chip-color);
  color: var(--chip-text);
}

/* No celular, os tipos rolam na horizontal em vez de ocupar várias linhas */
@media (max-width: 640px) {
  .type-chips {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--screen-glow) transparent;
  }

  .type-chip {
    flex: none;
  }
}

/* Ordenação */
.sort-controls {
  display: flex;
  gap: 8px;
}

.sort-select,
.sort-direction {
  background: var(--screen-inset);
  color: var(--text-primary);
  border: 2px solid var(--screen-line);
  border-radius: 10px;
  font-family: inherit;
  font-weight: 600;
  transition: border-color 0.15s ease;
}

.sort-select {
  padding: 11px 12px;
  font-size: 0.9rem;
  cursor: pointer;
}

.sort-select option {
  background: var(--screen-card);
  color: var(--text-primary);
}

.sort-direction {
  width: 44px;
  display: grid;
  place-items: center;
  font-size: 1.1rem;
  line-height: 1;
}

.sort-select:hover,
.sort-direction:hover {
  border-color: var(--screen-glow);
}

@media (max-width: 640px) {
  .sort-controls {
    flex: 1 1 100%;
  }

  .sort-select {
    flex: 1;
    min-width: 0;
  }
}
</file>

